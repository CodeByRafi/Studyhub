# Environment Configuration
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Option 1: Cloud Database (Neon, Supabase, etc.) — RECOMMENDED for production
# DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# Option 2: Local PostgreSQL — for local development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=studyhub

# ============================================
# JWT Secret — generate a strong random key for production!
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_me

# ============================================
# Cloudinary (for file uploads in production) — Phase 3
# ============================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
